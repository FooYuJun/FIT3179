{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Seasonal Patterns in Turtle Nesting Observations",
        "subtitle": "Monthly observations compared across years",
        "anchor": "start"
    },
    "vconcat": [
        {
            "hconcat": [
                {
                    "width": 210,
                    "height": 130,
                    "title": {
                        "text": "Year 1",
                        "fontSize": 15
                    },
                    "data": {
                        "url": "data/turtle_nesting_calendar.csv"
                    },
                    "transform": [
                        {
                            "filter": "datum.year == 2020"
                        }
                    ],
                    "mark": {
                        "type": "line",
                        "point": true,
                        "color": "#168c8c"
                    },
                    "encoding": {
                        "x": {
                            "field": "month_name",
                            "title": "Month",
                            "type": "ordinal",
                            "sort": [
                                "Jan",
                                "Feb",
                                "Mar",
                                "Apr",
                                "May",
                                "Jun",
                                "Jul",
                                "Aug",
                                "Sep",
                                "Oct",
                                "Nov",
                                "Dec"
                            ]
                        },
                        "y": {
                            "field": "nesting_observations",
                            "title": "No. of Nesting",
                            "type": "quantitative"
                        },
                        "tooltip": [
                            {
                                "field": "year",
                                "type": "ordinal",
                                "title": "Year"
                            },
                            {
                                "field": "month_name",
                                "type": "ordinal",
                                "title": "Month"
                            },
                            {
                                "field": "nesting_observations",
